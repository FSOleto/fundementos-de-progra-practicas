
#include <stdio.h>
#include <math.h>

int main()
{
     float r,h;
     float area_lat,volumen,area_total;
     const float PI=3.1416;

     printf("ingresar el Radio del cilindro: ");
     scanf("%f",&r);

    printf("ingresar la altura del cilindro: ");
    scanf("%f",&h);

    area_lat= 2*PI*r*h;
    area_total=2*PI*r*(r+h);
    volumen=PI*pow(r,2)*h;

    printf("-----RESULTADOS-----\n");
    printf("Radio Ingresado:     %.2f\n",r);
    printf("Altura Ingresada:     %.2f\n",h);
    printf("--------------------------\n");
    printf("Area Lateral:     %.4f unidades cubicas\n",area_lat);
    printf("Area total:     %.4f unidades cubicas\n",area_total);
    printf("Volumen:     %.4f unidades cubicas\n",volumen);
    printf("--------------------------\n");
return 0;
}
