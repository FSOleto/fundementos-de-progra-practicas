Ejercicio 5

C++
#include <iostream>

using namespace std;

int main() {
    long long n, complemento = 0, multiplicador = 1;
    cin >> n;
    
    if (n < 0) n = -n;
    if (n == 0) complemento = 9;
    
    while (n > 0) {
        int digito = n % 10;
        complemento = complemento + (9 - digito) * multiplicador;
        multiplicador *= 10;
        n /= 10;
    }
    
    cout << complemento << "\n";
    return 0;
}
