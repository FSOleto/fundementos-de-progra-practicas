Ejercicio 2

C++
#include <iostream>

using namespace std;

int main() {
    long long n, invertido = 0;
    cin >> n;
    
    bool negativo = false;
    if (n < 0) {
        negativo = true;
        n = -n;
    }
    
    while (n > 0) {
        invertido = invertido * 10 + (n % 10);
        n /= 10;
    }
    
    if (negativo) invertido = -invertido;
    
    cout << invertido << "\n";
    return 0;
}
