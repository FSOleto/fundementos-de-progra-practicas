#include <iostream>

using namespace std;

void SISTEMA(float A, float B, float C, float D, float E, float F, float &X, float &Y) {
    float det = A * E - B * D;
    if (det != 0) {
        X = (-C * E - B * -F) / det;
        Y = (A * -F - -C * D) / det;
    }
}

int main() {
    float A, B, C, D, E, F, X = 0, Y = 0;
    cin >> A >> B >> C >> D >> E >> F;
    SISTEMA(A, B, C, D, E, F, X, Y);
    cout << X << " " << Y << "\n";
    return 0;
}
