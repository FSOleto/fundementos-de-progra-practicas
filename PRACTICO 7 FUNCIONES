#include <iostream>
#include <cmath>

using namespace std;

void cuadratica(float a, float b, float c) {
    if (a == 0) return;
    float disc = b * b - 4 * a * c;
    if (disc > 0) {
        float x1 = (-b + sqrt(disc)) / (2 * a);
        float x2 = (-b - sqrt(disc)) / (2 * a);
        cout << x1 << " " << x2 << "\n";
    } else if (disc == 0) {
        cout << -b / (2 * a) << "\n";
    } else {
        float real = -b / (2 * a);
        float imag = sqrt(-disc) / (2 * a);
        cout << real << " + " << imag << "i y " << real << " - " << imag << "i\n";
    }
}

int main() {
    float a, b, c;
    cin >> a >> b >> c;
    cuadratica(a, b, c);
    return 0;
}
