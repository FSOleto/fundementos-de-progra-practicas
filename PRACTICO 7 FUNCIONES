C++
#include <iostream>
#include <string>
#include <cmath>

using namespace std;

string unidad(int n) {
    string u[] = {"", "un", "dos", "tres", "cuatro", "cinco", "seis", "siete", "ocho", "nueve"};
    return u[n];
}

string decena(int n) {
    string d[] = {"", "diez", "veinte", "treinta", "cuarenta", "cincuenta", "sesenta", "setenta", "ochenta", "noventa"};
    string esp[] = {"once", "doce", "trece", "catorce", "quince", "dieciseis", "diecisiete", "dieciocho", "diecinueve"};
    if (n > 10 && n < 20) return esp[n - 11];
    if (n == 10 || n == 20 || n == 30 || n == 40 || n == 50 || n == 60 || n == 70 || n == 80 || n == 90) return d[n / 10];
    if (n > 20 && n < 30) return "veinti" + unidad(n - 20);
    if (n > 30) return d[n / 10] + " y " + unidad(n % 10);
    return unidad(n);
}

string centena(int n) {
    string c[] = {"", "ciento", "doscientos", "trescientos", "cuatrocientos", "quinientos", "seiscientos", "setecientos", "ochocientos", "novecientos"};
    if (n == 100) return "cien";
    if (n > 100) return c[n / 100] + (n % 100 != 0 ? " " + decena(n % 100) : "");
    return decena(n);
}

string aLiteral(float R) {
    int ent = (int)R;
    int dec = round((R - ent) * 100);
    string res = "";
    if (ent >= 1000) {
        if (ent / 1000 == 1) res += "un mil ";
        else res += unidad(ent / 1000) + " mil ";
        ent %= 1000;
    }
    if (ent > 0) res += centena(ent) + " ";
    if (res == "") res = "cero ";
    res += (dec < 10 ? "0" : "") + to_string(dec) + "/100 bolivianos";
    return res;
}

int main() {
    float R;
    cin >> R;
    cout << aLiteral(R) << "\n";
    return 0;
}
