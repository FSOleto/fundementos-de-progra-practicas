using namespace std;

int binToDec(string bin) {
    int dec = 0;
    int p = 0;
    for (int i = bin.length() - 1; i >= 0; i--) {
        if (bin[i] == '1') dec += pow(2, p);
        p++;
    }
    return dec;
}

int main() {
