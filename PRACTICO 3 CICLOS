int main() {
    long long a, b, tempA, tempB, temp;
    cin >> a >> b;
    
    tempA = a;
    tempB = b;
    
    while(tempB != 0) {
        temp = tempB;
        tempB = tempA % tempB;
        tempA = temp;
    }
    
    long long mcd = tempA;
    long long mcm = (a * b) / mcd;
    
    cout << mcm << "\n";
