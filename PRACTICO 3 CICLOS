Ejercicio 9

C++
#include <iostream>
#include <cmath>

using namespace std;

int main() {
    double x, s = 0;
    int n;
    cin >> x >> n;
    
    for(int i = 1; i <= n; i++) {
        long long fac = 1;
        for(int j = 1; j <= i; j++) {
            fac *= j;
        }
        double term = pow(x, i) / fac;
        if(i % 2 != 0) {
            s += term;
        } else {
            s -= term;
        }
    }
    
    cout << s << "\n";
    return 0;
}
Ejercicio 10

C++
#include <iostream>
#include <cmath>

using namespace std;

int main() {
    double x, s = 0;
    int n;
    cin >> x >> n;
    
    int sign = 1;
    for(int i = 1; i <= n; i += 2) {
        long long fac = 1;
        for(int j = 1; j <= i; j++) {
            fac *= j;
        }
        s += sign * (pow(x, i) / fac);
        sign *= -1;
    }
    
    cout << s << "\n";
    return 0;
}
