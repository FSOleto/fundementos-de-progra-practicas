Ejercicio 14

C++
#include <iostream>

using namespace std;

int main() {
    int n;
    cin >> n;
    
    long long f0 = 1, f1 = 1, f_next;
    
    if (n == 0 || n == 1) {
        cout << 1 << "\n";
    } else {
        for(int i = 2; i <= n; i++) {
            f_next = f1 + f0;
            f0 = f1;
            f1 = f_next;
        }
        cout << f1 << "\n";
    }
    return 0;
}
