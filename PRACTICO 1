//Ejercicio 10


#include <stdio.h>

int main() {
    float horas, pago_hora, salario;
    printf("Horas trabajadas: ");
    scanf("%f", &horas);
    printf("Pago por hora: ");
    scanf("%f", &pago_hora);
    
    salario = horas * pago_hora;
    
    if (horas > 40) {
        salario = salario + (salario * 0.10);
    }
    
    printf("Salario total: %.2f\n", salario);
    return 0;
}
