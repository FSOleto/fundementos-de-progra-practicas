
#include <stdio.h>

int main() {
    char nombre[100];
    int edad;
    char carrera[100];
    int semestre;

    printf("Nombre completo: ");
    scanf(" %[^\n]", nombre);
    printf("Edad: ");
    scanf("%d", &edad);
    printf("Carrera: ");
    scanf(" %[^\n]", carrera);
    printf("Semestre: ");
    scanf("%d", &semestre);

    printf("Estudiante: %s, Edad: %d, Carrera: %s, Semestre: %d\n", nombre, edad, carrera, semestre);

    return 0;
}
