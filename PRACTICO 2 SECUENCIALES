#include <stdio.h>
#include <math.h>

int main() {
    float c, t, cuota, monto_total, interes_total;
    int n;
    printf("Capital prestado: ");
    scanf("%f", &c);
    printf("Tasa de interes mensual: ");
    scanf("%f", &t);
    printf("Numero de cuotas: ");
    scanf("%d", &n);
    cuota = c * (t * pow(1 + t, n)) / (pow(1 + t, n) - 1);
    monto_total = cuota * n;
    interes_total = monto_total - c;
    printf("Cuota mensual: %.2f\nMonto total: %.2f\nInteres total: %.2f\n", cuota, monto_total, interes_total);
    return 0;
}
