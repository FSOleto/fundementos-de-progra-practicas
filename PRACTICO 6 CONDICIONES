#include <iostream>
#include <cmath>

using namespace std;

int main() {
    float a, b, c, disc, x1, x2;
    cout << "Coeficientes a, b, c: ";
    cin >> a >> b >> c;
    
    disc = (b * b) - (4 * a * c);
    
    if (disc >= 0 && a != 0) {
        x1 = (-b + sqrt(disc)) / (2 * a);
        x2 = (-b - sqrt(disc)) / (2 * a);
        cout << "x1 = " << x1 << "\nx2 = " << x2 << "\n";
    }
    
