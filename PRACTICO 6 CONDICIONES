Ejercicio 6

C++
#include <iostream>
#include <cmath>

using namespace std;

int main() {
    float a, b, c, disc, x1, x2, real, imag;
    cout << "Coeficientes a, b, c: ";
    cin >> a >> b >> c;
    
    if (a == 0 && b == 0) {
        cout << "Ecuacion degenerada\n";
    } else if (a == 0 && b != 0) {
        cout << "Ecuacion lineal, x = " << -c / b << "\n";
    } else {
        disc = (b * b) - (4 * a * c);
        if (disc > 0) {
            x1 = (-b + sqrt(disc)) / (2 * a);
            x2 = (-b - sqrt(disc)) / (2 * a);
            cout << "Raices reales distintas: x1 = " << x1 << ", x2 = " << x2 << "\n";
        } else if (disc == 0) {
            x1 = -b / (2 * a);
            cout << "Raiz real doble: x = " << x1 << "\n";
        } else {
            real = -b / (2 * a);
            imag = sqrt(-disc) / (2 * a);
            cout << "Raices complejas: " << real << " + " << imag << "i y " << real << " - " << imag << "i\n";
        }
    }
    
    return 0;
}
Ejercicio 7

C++
#include <iostream>

using namespace std;

int main() {
    float a, b, c, d, e, f, det, x, y;
    cout << "Coeficientes a, b, c (Ecuacion 1): ";
    cin >> a >> b >> c;
    cout << "Coeficientes d, e, f (Ecuacion 2): ";
    cin >> d >> e >> f;
    
    det = a * e - b * d;
    
    if (det == 0) {
        if (a * f == c * d && b * f == c * e) {
            cout << "Infinitas soluciones\n";
        } else {
            cout << "Sin solucion\n";
        }
    } else {
        x = (c * e - b * f) / det;
        y = (a * f - c * d) / det;
        cout << "X = " << x << "\nY = " << y << "\n";
    }
    
    return 0;
}
