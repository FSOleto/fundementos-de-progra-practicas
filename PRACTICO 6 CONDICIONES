C++
#include <iostream>

using namespace std;

int main() {
    int opcion;
    float area, pi = 3.141592;
    
    cout << "1. Cuadrado\n2. Circulo\n3. Triangulo\nOpcion: ";
    cin >> opcion;
    
    if (opcion == 1) {
        float l;
        cout << "Lado: "; cin >> l;
        area = l * l;
        cout << "Area: " << area << "\n";
    } else if (opcion == 2) {
        float r;
        cout << "Radio: "; cin >> r;
        area = pi * (r * r);
        cout << "Area: " << area << "\n";
    } else if (opcion == 3) {
        float b, h;
        cout << "Base: "; cin >> b;
        cout << "Altura: "; cin >> h;
        area = (b * h) / 2;
        cout << "Area: " << area << "\n";
    }
    
    return 0;
}
Ejercicio 10

C++
#include <iostream>

using namespace std;

int main() {
    char continuar = 's';
    
    while (continuar == 's' || continuar == 'S') {
        float p1, p2, prac, ef, nota_final;
        int faltas;
        
        cout << "Parcial 1 (sobre 100): "; cin >> p1;
        cout << "Parcial 2 (sobre 100): "; cin >> p2;
        cout << "Examen Practico (sobre 100): "; cin >> prac;
        cout << "Examen Final (sobre 100): "; cin >> ef;
        cout << "Numero de faltas: "; cin >> faltas;
        
        if (faltas > 9) {
            ef = 0;
        }
        
        nota_final = ((p1 + p2) / 2) * 0.40 + (prac * 0.20) + (ef * 0.40);
        
        cout << "Nota Final: " << nota_final << "\n";
        
        if (nota_final >= 51) {
            cout << "APROBADO\n";
        } else {
            cout << "REPROBADO\n";
        }
        
        cout << "Hay mas alumnos? (s/n): ";
        cin >> continuar;
    }
    
    return 0;
}
