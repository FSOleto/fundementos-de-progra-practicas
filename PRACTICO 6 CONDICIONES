Ejercicio 4

C++
#include <iostream>

using namespace std;

int main() {
    int h1, m1, s1, h2, m2, s2;
    long t1, t2, diff;
    
    cout << "Horario 1 (HH MM SS): ";
    cin >> h1 >> m1 >> s1;
    cout << "Horario 2 (HH MM SS): ";
    cin >> h2 >> m2 >> s2;
    
    t1 = h1 * 3600 + m1 * 60 + s1;
    t2 = h2 * 3600 + m2 * 60 + s2;
    diff = t2 - t1;
    
    int hd = diff / 3600;
    int md = (diff % 3600) / 60;
    int sd = diff % 60;
    
    cout << "Tiempo transcurrido: " << hd << ":" << md << ":" << sd << "\n";
    
    return 0;
}
